---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, REPO, LATEST_VERSION } from "../links";

interface Props {
  /** Short page title; the home page passes none. */
  title?: string;
  description: string;
  /** Text pages (privacy, legal…) get the narrow reading column. */
  prose?: boolean;
  /** Text pages list their sections at the side on wide screens. */
  toc?: boolean;
}
const { title, description, prose = false, toc = true } = Astro.props;

// Text pages: read the rendered page once to list its h2 sections, giving an
// id to those without one, so the list needs no script.
let body = "";
const sections: { id: string; html: string }[] = [];
if (prose) {
  body = await Astro.slots.render("default");
  const used = new Set<string>();
  body = body.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_m, attrs: string, inner: string) => {
    let id = /\sid="([^"]+)"/.exec(attrs)?.[1];
    if (!id) {
      id = inner.replace(/<[^>]+>/g, "").toLowerCase().replace(/&[a-z#0-9]+;/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "section";
      while (used.has(id)) id += "-2";
      attrs += ` id="${id}"`;
    }
    used.add(id);
    sections.push({ id, html: inner.replace(/<(?!\/?(code|strong|em))[^>]+>/g, "") });
    return `<h2${attrs}>${inner}</h2>`;
  });
}
const withToc = prose && toc && sections.length >= 3;
const fullTitle = title ? `${title} · whereti` : "whereti: find any file by name, text or image";
const canonical = new URL(Astro.url.pathname, SITE).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "whereti",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Windows 10, Windows 11",
  softwareVersion: LATEST_VERSION,
  license: "https://opensource.org/licenses/MIT",
  url: SITE,
  codeRepository: REPO,
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: "Software Hive S.R.L." },
};

// Before the first paint: the saved theme, else the system's. Picking the
// system's theme again forgets the choice (as on silentsilo.com).
const themeScript = `(function(){try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}})();`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07080e" media="(prefers-color-scheme: dark)" />
    <meta name="application-name" content="whereti" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="whereti" />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    {prose ? (
      <main id="main" class:list={["wrap page-doc", { "has-toc": withToc }]}>
        {withToc && (
          <aside class="toc">
            <nav aria-label="On this page">
              <p>On this page</p>
              <ol>{sections.map((x) => <li><a href={`#${x.id}`} set:html={x.html} /></li>)}</ol>
            </nav>
          </aside>
        )}
        <article class="prose"><Fragment set:html={body} /></article>
      </main>
    ) : (
      <main id="main"><slot /></main>
    )}
    <Footer />
    <script>
      // Marks the section being read in the side list of text pages.
      const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
      const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
      const mark = () => {
        let cur = 0;
        heads.forEach((h, i) => {
          if (h && h.getBoundingClientRect().top < 120) cur = i;
        });
        links.forEach((a, i) => a.setAttribute("aria-current", String(i === cur)));
      };
      if (links.length) {
        addEventListener("scroll", mark, { passive: true });
        mark();
      }
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </body>
</html>
