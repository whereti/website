---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { CONTACT, BUY_PERSONAL, BUY_BUSINESS } from "../links";
---
<Base title="Support whereti" description="whereti is free in full. A supporter license, $19 for you or $39 per PC for a company, pays for its development. One payment, for life.">
  <section class="page-head">
    <div class="wrap">
      <span class="kicker">Supporter license</span>
      <h1>Support <span class="grad">whereti</span></h1>
      <p>
        whereti is free, all of it, for everyone. If it saves you time, a supporter license pays for its development,
        and whereti thanks you by name.
      </p>
    </div>
  </section>

  <section style="padding-bottom:8px">
    <div class="wrap" style="max-width:800px">
      <div class="plans">
        <div class="plan featured" id="personal">
          <span class="kicker">Personal</span>
          <p class="price"><b>$19</b> one payment</p>
          <ul class="checks">
            <li><Icon name="check" />Yours for life, with every update</li>
            <li><Icon name="check" />On all your PCs</li>
            <li><Icon name="check" />Your name in whereti</li>
          </ul>
          <a class="btn btn-primary" href={BUY_PERSONAL}><Icon name="heart" />Buy for $19</a>
        </div>
        <div class="plan" id="business">
          <span class="kicker">Business</span>
          <p class="price"><b>$39</b> per PC, one payment</p>
          <ul class="checks">
            <li><Icon name="check" />For life, with every update</li>
            <li><Icon name="check" />An invoice with your company's details</li>
            <li><Icon name="check" />As many PCs as you need</li>
          </ul>
          <a class="btn btn-ghost" href={BUY_BUSINESS}>Buy for business</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap page-doc" style="padding-top:8px">
    <div class="prose">
    <h2>How it works</h2>
    <ol>
      <li>
        You pay through Lemon Squeezy, our reseller: it handles the payment, the VAT and the invoice, and is the seller
        on your receipt.
      </li>
      <li>A minute later your key arrives by e-mail, from licenses@whereti.com.</li>
      <li>In whereti, open Settings, Support, paste the key and choose Activate. No internet is needed for that.</li>
    </ol>

    <h2>What it will not be</h2>
    <ul>
      <li>Nothing that works today is taken away or locked behind it.</li>
      <li>No account, no subscription to forget, no tracking.</li>
      <li>The key works offline, forever, on the versions to come as well.</li>
    </ul>

    <h2>Refunds</h2>
    <p>
      Changed your mind within 14 days? Write to <a href={`mailto:${CONTACT}`}>{CONTACT}</a> with your order number and
      you get your money back, no questions asked.
    </p>

    <h2>Lost your key?</h2>
    <p>
      Search your e-mail for "whereti supporter key". If it is gone, write to us with your order number and the e-mail
      you paid with.
    </p>

    <h2>Other ways to help</h2>
    <ul>
      <li>Tell a friend or a colleague who loses files.</li>
      <li>Report a bug, or a translation that reads badly, to <a href={`mailto:${CONTACT}`}>{CONTACT}</a>.</li>
    </ul>
    </div>
  </div>
</Base>

