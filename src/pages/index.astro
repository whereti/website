---
import Base from "../layouts/Base.astro";
import AppWindow from "../components/AppWindow.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Icon from "../components/Icon.astro";
import {
  REPO, LATEST_VERSION, INSTALLER_SIZE, LATEST_INSTALLER, LATEST_INSTALLER_NAME, INSTALLER_SHA256,
  RELEASE_NOTES, ALL_RELEASES,
} from "../links";
---
<Base description="whereti finds any file on your Windows PC as you type, by its name or by the words inside it. Free, open source, and your files never leave your computer.">
  <section class="hero2">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero2-grid">
      <div class="hero2-copy">
        <span class="eyebrow"><span class="spark"></span>Free and open source · Windows 10 and 11</span>
        <h1>Find any file.<br /><span class="grad">As you type.</span></h1>
        <p class="lead">
          Every file name on your drives and every word inside your documents, searched in a millisecond. Your files
          never leave your PC.
        </p>
        <div class="hero-actions">
          <DownloadButton />
          <a class="btn btn-ghost" href="#features">What it does</a>
        </div>
        <ul class="ticks">
          <li><Icon name="check" />No account</li>
          <li><Icon name="check" />No tracking</li>
          <li><Icon name="check" />v{LATEST_VERSION} · {INSTALLER_SIZE}</li>
        </ul>
      </div>
      <div class="hero2-shot"><AppWindow /></div>
    </div>
  </section>

  <section class="stats" aria-label="whereti in numbers">
    <div class="wrap stats-grid">
      <div><b>1 ms</b><span>to search millions of names</span></div>
      <div><b>&lt; 1 s</b><span>for a new file to show up</span></div>
      <div><b>0</b><span>accounts, ads or trackers</span></div>
      <div><b>8</b><span>languages</span></div>
    </div>
  </section>

  <section class="sec" id="features">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker">Everything is free</span>
        <h2>Search the way you remember</h2>
        <p>By a piece of the name, by a word inside, by where a photo was taken, by when you last touched it. No setup, no syntax to learn.</p>
      </div>

      <div class="bento">
        <article class="tile t-docs">
          <div class="tile-copy">
            <h3>Inside your documents</h3>
            <p>Type a word you remember and the document comes up, with the line where it appears. Even from a scan or a photo of a receipt.</p>
          </div>
          <div class="doc-chips" aria-hidden="true">
            <span class="ico pdf">PDF</span><span class="ico doc">DOC</span><span class="ico xls">XLS</span>
            <span class="ico ppt">PPT</span><span class="ico eml">EML</span><span class="ico txt">EPUB</span><span class="ico img">JPG</span>
          </div>
          <div class="snippets" aria-hidden="true">
            <div class="snippet"><span class="ico pdf">PDF</span><span><b>Apartment lease.pdf</b>…the deposit is returned within <mark>30 days</mark> after the keys…</span></div>
            <div class="snippet"><span class="ico eml">EML</span><span><b>Re: Payment terms.eml</b>…we can pay in <mark>30 days</mark> from the invoice date…</span></div>
            <div class="snippet"><span class="ico doc">DOC</span><span><b>Warranty card.docx</b>…returns are accepted for <mark>30 days</mark> with the receipt…</span></div>
          </div>
        </article>

        <article class="tile t-keys">
          <div class="keycaps" aria-hidden="true"><kbd>Ctrl</kbd><span>+</span><kbd>Shift</kbd><span>+</span><kbd>Space</kbd></div>
          <h3>From any app</h3>
          <p>One shortcut opens whereti over whatever you are doing. Pick your own in Settings.</p>
        </article>

        <article class="tile t-live">
          <div class="livefeed" aria-hidden="true">
            <div class="lf new"><span class="ico doc">DOC</span><span class="n">Offer for Maria.docx</span><em>just now</em></div>
            <div class="lf"><span class="ico xls">XLS</span><span class="n">Budget October.xlsx</span><em>2 min</em></div>
            <div class="lf"><span class="ico pdf">PDF</span><span class="n">Boarding pass.pdf</span><em>1 h</em></div>
          </div>
          <h3>Always up to date</h3>
          <p>New, renamed or deleted files show up within a second.</p>
        </article>

        <article class="tile t-private">
          <div class="big-ic" aria-hidden="true"><Icon name="lock" /></div>
          <h3>Private by design</h3>
          <p>No account, no tracking. Your files and searches never leave your PC; the only regular request is one update check a day, which you can turn off.</p>
          <a href="/privacy/">How private →</a>
        </article>

        <article class="tile t-preview">
          <h3>Look before you open</h3>
          <p>The preview shows the text with your words marked, what a folder holds, or what whereti read: a photo's camera, date and contents, a song's artist and length.</p>
          <div class="mini-preview" aria-hidden="true">
            <i style="width:82%"></i><i style="width:64%"></i><i class="hit" style="width:48%"></i><i style="width:75%"></i>
          </div>
        </article>

        <article class="tile t-light">
          <div class="big-ic" aria-hidden="true"><Icon name="feather" /></div>
          <h3>Light on your PC</h3>
          <p>About 55 bytes of memory per file. Steps aside while you play, present or run on battery.</p>
        </article>

        <article class="tile t-explorer">
          <h3>Works like Explorer</h3>
          <p>Enter opens, Ctrl+Enter shows it in its folder, F2 renames, Delete sends it to the Recycle Bin, Ctrl+C copies the file. Right-click and drag work as usual.</p>
        </article>

        <article class="tile t-filters">
          <h3>Filters, if you like</h3>
          <div class="chips" aria-hidden="true"><code>ext:pdf</code><code>dm:2025-03..2025-06</code><code>camera:iphone</code><code>author:popescu</code></div>
          <p>Plain words always work too, and a typo is forgiven.</p>
          <a href="/search/">Every search command →</a>
        </article>

        <article class="tile t-photos">
          <h3>Your photos, by place and by what they show</h3>
          <p>
            Type “rome” or “greece” and the photos taken there come up, from the position your phone wrote into them.
            Turn on recognition and “dog”, “beach” or “pizza” find the photos that show them. All of it on your PC.
          </p>
          <div class="chips" aria-hidden="true"><code>loc:greece</code><code>dog</code><code>beach taken:2025-08</code></div>
        </article>

        <article class="tile t-learns">
          <h3>Learns what matters to you</h3>
          <p>
            Files you open often, and folders where you are working these days, come first. Learnt on your PC, never sent,
            and each part has its own switch.
          </p>
          <a href="/search/#order">What comes first →</a>
        </article>

        <article class="tile t-wide">
          <div class="big-ic" aria-hidden="true"><Icon name="window" /></div>
          <h3>Straight into Open and Save</h3>
          <p>
            Press Ctrl+Shift+Space while an app's Open or Save window is in front, pick the result, press Enter: that
            window jumps to the file's folder. whereti only fills in its address bar; you still choose Open or Save.
          </p>
        </article>

        <article class="tile">
          <div class="big-ic" aria-hidden="true"><Icon name="grid" /></div>
          <h3>Pictures as a grid</h3>
          <p>The Images tab shows thumbnails, straight from Windows. The arrows move by tile and by line.</p>
        </article>

        <article class="tile">
          <div class="big-ic" aria-hidden="true"><Icon name="archive" /></div>
          <h3>Inside ZIP, 7z and RAR</h3>
          <p>Archives are found by the files they hold, and ZIP and 7z also by the text of the documents inside.</p>
        </article>

        <article class="tile t-wide">
          <div class="big-ic" aria-hidden="true"><Icon name="copy" /></div>
          <h3>Find duplicates</h3>
          <p>
            <code class="inl">dupe:</code> lists identical files across your disks, compared byte by byte, with the ones
            that free the most space first. Files only in the cloud are never downloaded for it.
          </p>
          <div class="chips" aria-hidden="true"><code>dupe: size:&gt;100mb</code><code>dupe: ext:jpg</code></div>
        </article>

        <article class="tile t-wide">
          <div class="big-ic" aria-hidden="true"><Icon name="server" /></div>
          <h3>Your NAS too</h3>
          <p>
            Add a network folder like <code class="inl">{"\\\\nas\\photos"}</code> or a mapped drive in Settings, Search. whereti looks through it once
            an hour and finds its files by name, under “On the network”.
          </p>
          <a href="/faq/#network">How it works →</a>
        </article>

        <article class="tile t-wide">
          <div class="big-ic" aria-hidden="true"><Icon name="sparkle" /></div>
          <h3>Finds what you mean, if you want</h3>
          <p>
            Turn on search by meaning and two or more words also find documents that say the same thing in other words:
            “rental contract” brings up the lease, under “Close in meaning”. A small model is downloaded once; your
            documents are read on your PC and never leave it.
          </p>
          <a href="/faq/#meaning">How it works →</a>
        </article>

        <article class="tile t-wide">
          <div class="big-ic" aria-hidden="true"><Icon name="image" /></div>
          <h3>Every picture and e-book</h3>
          <p>
            AVIF, HEIC, JPEG XL and camera RAW files (CR3, NEF, ARW, DNG…) sit in the Images tab with SVG, PSD and other
            drawings. Text is read from EPUB and FB2 e-books and XPS files too.
          </p>
          <a href="/faq/#formats">Every format →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="sec dl-sec" id="download">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Download</span>
        <h2>Get <span class="grad">whereti</span></h2>
        <p>One installer, free, signed by Software Hive S.R.L.</p>
      </div>

      <div class="dl-card">
        <img src="/icon.svg" alt="" width="56" height="56" />
        <div>
          <h3>whereti for Windows</h3>
          <div class="meta">
            Version {LATEST_VERSION} · Windows 10 and 11, 64-bit · {INSTALLER_SIZE} · free, MIT license ·
            <a href={RELEASE_NOTES}>Release notes</a>
          </div>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={LATEST_INSTALLER}><Icon name="download" />Download</a>
        </div>
      </div>

      <div class="dl-more">
        <div class="card">
          <h3>Install in three steps</h3>
          <ol class="steps">
            <li><b>Run the installer</b><span>Open {LATEST_INSTALLER_NAME} and choose Install. Windows asks once for administrator permission.</span></li>
            <li><b>Wait a moment</b><span>whereti opens with a short welcome page while it learns your file names. You can search already.</span></li>
            <li><b>Press Ctrl+Shift+Space</b><span>From any app. whereti waits next to the clock and starts with Windows; both can be changed in Settings.</span></li>
          </ol>
        </div>
        <div class="card" id="verify">
          <h3><Icon name="shield" />Check the installer</h3>
          <p>
            The installer and every program in it are signed by <strong>Software Hive S.R.L.</strong> Right-click the
            file, choose Properties, then Digital Signatures, to see it.
          </p>
          {INSTALLER_SHA256 && (
            <p>SHA-256 of {LATEST_INSTALLER_NAME}:<span class="hash">{INSTALLER_SHA256}</span></p>
          )}
          <p><a href="/security/#checking-the-download">How to check it</a></p>
        </div>
        <div class="card">
          <h3><Icon name="bolt" />Update or remove</h3>
          <p>
            whereti tells you when a new version exists and installs it when you choose Install update. A new installer
            run by hand replaces the old version and keeps your settings.
          </p>
          <p>
            To remove it, use Settings, Apps in Windows. That removes the programs, the service, the index and the
            settings.
          </p>
        </div>
      </div>

      <p class="dl-foot">
        Not on Windows? whereti reads the file system of Windows drives directly, so it runs only on Windows.
        <a href={ALL_RELEASES}>All releases</a> · <a href={REPO}>Source on GitHub, MIT license</a>
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap end-grid">
      <div class="trust-card">
        <span class="kicker">Open source · MIT</span>
        <h2>Check it rather than trust it</h2>
        <p>
          All of whereti is on GitHub: the app, the background service, the document reader and the installer. Every
          download is signed by Software Hive S.R.L.
        </p>
        <div class="trust-actions">
          <a class="btn btn-ghost" href={REPO}><Icon name="github" />Source on GitHub</a>
          <a class="btn btn-ghost" href="/security/"><Icon name="shield" />How it stays safe</a>
        </div>
      </div>
      <div class="cta2-card">
        <h2>Stop looking for files.</h2>
        <p>Install whereti, press Ctrl+Shift+Space, type the first word that comes to mind.</p>
        <DownloadButton />
      </div>
    </div>
  </section>
</Base>
