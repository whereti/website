---
import Base from "../layouts/Base.astro";
import AppWindow from "../components/AppWindow.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Icon from "../components/Icon.astro";
import { REPO, LATEST_VERSION, INSTALLER_SIZE, RELEASED } from "../links";
---
<Base description="whereti finds any file on your Windows PC as you type, by its name or by the words inside it. Free, open source, and your files never leave your computer.">
  <section class="hero2">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero2-grid">
      <div class="hero2-copy">
        <span class="eyebrow"><span class="spark"></span>Free and open source · Windows 10 and 11</span>
        <h1>Find any file.<br /><span class="grad">As you type.</span></h1>
        <p class="lead">
          Every file name on your drives and every word inside your documents, searched in a millisecond. Your files
          never leave your PC.
        </p>
        <div class="hero-actions">
          <DownloadButton />
          <a class="btn btn-ghost" href="#features">What it does</a>
        </div>
        <ul class="ticks">
          <li><Icon name="check" />No account</li>
          <li><Icon name="check" />No tracking</li>
          <li><Icon name="check" />{RELEASED ? `v${LATEST_VERSION} · ${INSTALLER_SIZE}` : "Coming soon"}</li>
        </ul>
      </div>
      <div class="hero2-shot"><AppWindow /></div>
    </div>
  </section>

  <section class="stats" aria-label="whereti in numbers">
    <div class="wrap stats-grid">
      <div><b>1 ms</b><span>to search millions of names</span></div>
      <div><b>&lt; 1 s</b><span>for a new file to show up</span></div>
      <div><b>0</b><span>accounts, ads or trackers</span></div>
      <div><b>8</b><span>languages</span></div>
    </div>
  </section>

  <section class="sec" id="features">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker">Everything is free</span>
        <h2>Search the way you remember</h2>
        <p>By a piece of the name, by a word inside, by where a photo was taken, by when you last touched it. No setup, no syntax to learn.</p>
      </div>

      <div class="bento">
        <article class="tile t-docs">
          <div class="tile-copy">
            <h3>Inside your documents</h3>
            <p>Type a word you remember and the document comes up, with the line where it appears. Even from a scan or a photo of a receipt.</p>
          </div>
          <div class="doc-chips" aria-hidden="true">
            <span class="ico pdf">PDF</span><span class="ico doc">DOC</span><span class="ico xls">XLS</span>
            <span class="ico ppt">PPT</span><span class="ico eml">EML</span><span class="ico txt">TXT</span><span class="ico img">JPG</span>
          </div>
          <div class="snippets" aria-hidden="true">
            <div class="snippet"><span class="ico pdf">PDF</span><span><b>Apartment lease.pdf</b>…the deposit is returned within <mark>30 days</mark> after the keys…</span></div>
            <div class="snippet"><span class="ico eml">EML</span><span><b>Re: Payment terms.eml</b>…we can pay in <mark>30 days</mark> from the invoice date…</span></div>
            <div class="snippet"><span class="ico doc">DOC</span><span><b>Warranty card.docx</b>…returns are accepted for <mark>30 days</mark> with the receipt…</span></div>
          </div>
        </article>

        <article class="tile t-keys">
          <div class="keycaps" aria-hidden="true"><kbd>Ctrl</kbd><span>+</span><kbd>Shift</kbd><span>+</span><kbd>Space</kbd></div>
          <h3>From any app</h3>
          <p>One shortcut opens whereti over whatever you are doing. Pick your own in Settings.</p>
        </article>

        <article class="tile t-live">
          <div class="livefeed" aria-hidden="true">
            <div class="lf new"><span class="ico doc">DOC</span><span class="n">Offer for Maria.docx</span><em>just now</em></div>
            <div class="lf"><span class="ico xls">XLS</span><span class="n">Budget October.xlsx</span><em>2 min</em></div>
            <div class="lf"><span class="ico pdf">PDF</span><span class="n">Boarding pass.pdf</span><em>1 h</em></div>
          </div>
          <h3>Always up to date</h3>
          <p>New, renamed or deleted files show up within a second.</p>
        </article>

        <article class="tile t-private">
          <div class="big-ic" aria-hidden="true"><Icon name="lock" /></div>
          <h3>Private by design</h3>
          <p>No account, no tracking. Your files and searches never leave your PC; the only regular request is one update check a day, which you can turn off.</p>
          <a href="/privacy/">How private →</a>
        </article>

        <article class="tile t-preview">
          <h3>Look before you open</h3>
          <p>The preview shows the text with your words marked, or what a folder holds.</p>
          <div class="mini-preview" aria-hidden="true">
            <i style="width:82%"></i><i style="width:64%"></i><i class="hit" style="width:48%"></i><i style="width:75%"></i>
          </div>
        </article>

        <article class="tile t-light">
          <div class="big-ic" aria-hidden="true"><Icon name="feather" /></div>
          <h3>Light on your PC</h3>
          <p>About 55 bytes of memory per file. Steps aside while you play, present or run on battery.</p>
        </article>

        <article class="tile t-explorer">
          <h3>Works like Explorer</h3>
          <p>Enter opens, Ctrl+Enter shows it in its folder, right-click gives the usual menu, drag a result into any app.</p>
        </article>

        <article class="tile t-filters">
          <h3>Filters, if you like</h3>
          <div class="chips" aria-hidden="true"><code>ext:pdf</code><code>dm:2025-03..2025-06</code><code>loc:italy</code></div>
          <p>Plain words always work too.</p>
          <a href="/search/">Every search command →</a>
        </article>

        <article class="tile t-photos">
          <h3>Your photos, by place and by what they show</h3>
          <p>
            Type “rome” or “greece” and the photos taken there come up, from the position your phone wrote into them.
            Turn on recognition and “dog”, “beach” or “pizza” find the photos that show them. All of it on your PC.
          </p>
          <div class="chips" aria-hidden="true"><code>loc:greece</code><code>dog</code><code>beach dm:2025-08</code></div>
        </article>

        <article class="tile t-learns">
          <h3>Learns what matters to you</h3>
          <p>
            Files you open often, and folders where you are working these days, come first. Learnt on your PC, never sent,
            and each part has its own switch.
          </p>
          <a href="/search/#order">What comes first →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="wrap trust-card">
      <div>
        <span class="kicker">Open source · MIT</span>
        <h2>Check it rather than trust it</h2>
        <p>
          All of whereti is on GitHub: the app, the background service, the document reader and the installer. Every
          download is signed by Software Hive S.R.L.
        </p>
      </div>
      <div class="trust-actions">
        <a class="btn btn-ghost" href={REPO}><Icon name="github" />Source on GitHub</a>
        <a class="btn btn-ghost" href="/security/"><Icon name="shield" />How it stays safe</a>
      </div>
    </div>
  </section>

  <section class="cta2">
    <div class="wrap">
      <div class="cta2-card">
        <img src="/icon.svg" alt="" width="72" height="72" />
        <h2>Stop looking for files.</h2>
        <p>Install whereti, press Ctrl+Shift+Space, type the first word that comes to mind.</p>
        <DownloadButton />
      </div>
    </div>
  </section>
</Base>
