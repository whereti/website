---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import {
  RELEASED, LATEST_VERSION, LATEST_INSTALLER, LATEST_INSTALLER_NAME, INSTALLER_SHA256, INSTALLER_SIZE,
  RELEASE_NOTES, ALL_RELEASES, REPO, CONTACT,
} from "../links";
---
<Base title="Download whereti" description="Download whereti for Windows 10 and 11: one installer, free, signed by Software Hive S.R.L.">
  <section class="dl-hero">
    <div class="wrap">
      <h1>Download <span class="grad">whereti</span></h1>
      {RELEASED ? (
        <p><a class="pill" href={RELEASE_NOTES}>Version {LATEST_VERSION} · Release notes</a></p>
      ) : (
        <p><span class="pill">The first public version is coming soon</span></p>
      )}
    </div>
  </section>

  <section class="sec" style="padding-top:16px">
    <div class="wrap">
      <div class="card dl-card">
        <img src="/icon.svg" alt="" width="64" height="64" />
        <div>
          <h2>whereti for Windows</h2>
          <div class="meta">Windows 10 and 11, 64-bit · {INSTALLER_SIZE} · free, MIT license</div>
        </div>
        {RELEASED ? (
          <a class="btn btn-primary" href={LATEST_INSTALLER}><Icon name="download" />Download</a>
        ) : (
          <a class="btn btn-ghost" href={REPO}><Icon name="github" />Source</a>
        )}
      </div>

      {!RELEASED && (
        <p class="note soon" style="max-width:720px;margin:20px auto 0">
          <strong>Not released yet.</strong> whereti is being finished. The source is on GitHub today; the signed installer
          will be here, and on GitHub, with the first release. Write to <a href={`mailto:${CONTACT}`}>{CONTACT}</a> if you
          want to try it early.
        </p>
      )}

      <div class="grid grid-3" style="margin-top:40px">
        <div class="card">
          <h3>1. Run the installer</h3>
          <p>Open {LATEST_INSTALLER_NAME} and choose Install. Windows asks once for administrator permission.</p>
        </div>
        <div class="card">
          <h3>2. Wait a moment</h3>
          <p>whereti opens with a short welcome page while it learns your file names. You can search already.</p>
        </div>
        <div class="card">
          <h3>3. Press Ctrl+Alt+Space</h3>
          <p>From any app. whereti waits next to the clock and starts with Windows; both can be changed in Settings.</p>
        </div>
      </div>

      <div class="grid grid-2" style="margin-top:16px">
        <div class="card" id="verify">
          <h3>Check the installer</h3>
          <p>
            The installer and every program in it are signed by <strong>Software Hive S.R.L.</strong> Right-click the file,
            choose Properties, then Digital Signatures, to see it.
          </p>
          {INSTALLER_SHA256 && (
            <p>SHA-256 of {LATEST_INSTALLER_NAME}:<span class="hash">{INSTALLER_SHA256}</span></p>
          )}
          <p><a href="/security/#checking-the-download">How to check it</a></p>
        </div>
        <div class="card">
          <h3>Update or remove</h3>
          <p>
            To update, run the new installer: it replaces the old version and keeps your settings. To remove whereti, use
            Settings, Apps in Windows. That removes the programs, the service, the index and the settings.
          </p>
        </div>
      </div>

      <p style="margin-top:32px;color:var(--muted)">
        Not on Windows? whereti reads the file system of Windows drives directly, so it runs only on Windows.
        <br /><a href={ALL_RELEASES}>All releases</a> · <a href={REPO}>The source is on GitHub under the MIT license</a>
      </p>
    </div>
  </section>
</Base>
