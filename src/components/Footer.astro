---
import { REPO, CONTACT, SECURITY, DOWNLOAD, RELEASED, RELEASE_NOTES, SILENTSILO } from "../links";
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/"><img src="/icon.svg" alt="" width="28" height="28" />whereti</a>
        <p>Find any file on your PC as you type: by its name or by the words inside it. Free and open source.</p>
      </div>
      <div>
        <h4>Use it</h4>
        <ul>
          <li><a href={DOWNLOAD}>{RELEASED ? "Download" : "Get it"}</a></li>
          <li><a href="/#features">Features</a></li>
          <li><a href="/faq/">Questions</a></li>
          <li><a href={RELEASE_NOTES}>Release notes</a></li>
          <li><a href="/supporter/">Support it</a></li>
        </ul>
      </div>
      <div>
        <h4>Trust</h4>
        <ul>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/security/">Security</a></li>
          <li><a href={REPO}>Source on GitHub</a></li>
          <li><a href={`${REPO}/blob/main/LICENSE`}>MIT license</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href={`mailto:${CONTACT}`}>{CONTACT}</a></li>
          <li><a href={`mailto:${SECURITY}`}>{SECURITY}</a></li>
          <li><a href="/who/">Who makes this</a></li>
          <li><a href="/legal/">Legal notice</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>Software Hive S.R.L., Romania · MIT · Also from us: <a href={SILENTSILO}>SilentSilo</a></p>
      <p>
        Microsoft, Windows, Word, Excel, PowerPoint and Outlook are trademarks of Microsoft Corporation. whereti is
        not affiliated with, sponsored or endorsed by Microsoft or by any other company named on this site.
      </p>
    </div>
  </div>
</footer>
